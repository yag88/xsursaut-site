// X-Sursaut — wrangler.jsonc — 2026-09-26
{
  "name": "xsursaut-site",
  "compatibility_date": "2026-09-25",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "xsursaut.org", "custom_domain": true },
    { "pattern": "www.xsursaut.org", "custom_domain": true }
  ],
  "assets": { "directory": "./site/public", "binding": "ASSETS", "run_worker_first": true }
}
